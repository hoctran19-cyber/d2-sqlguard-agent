# Configuration placeholders only; do not put credentials in this file.
SQLGUARD_LOG_LEVEL=INFO
SQLGUARD_QUERY_TIMEOUT_SECONDS=3
SQLGUARD_RUN_TIMEOUT_SECONDS=60

# Local PostgreSQL 16 sandbox placeholders. Replace every password before starting it.
# Use unique URL-safe passwords so these values can also be sourced by a shell.
SQLGUARD_PG_ADMIN_PASSWORD=replace-with-a-local-admin-password
SQLGUARD_PG_PORT=54329
SQLGUARD_DB_PASSWORD_SALES=replace-with-a-local-sales-password
SQLGUARD_DB_PASSWORD_FINANCE=replace-with-a-local-finance-password
SQLGUARD_DB_PASSWORD_OPERATIONS=replace-with-a-local-operations-password

# Host-side DSNs for SQLGuard. Use the matching role password above.
SQLGUARD_DB_DSN_SALES=postgresql://sqlguard_sales_app:replace-with-a-local-sales-password@127.0.0.1:54329/sqlguard_local
SQLGUARD_DB_DSN_FINANCE=postgresql://sqlguard_finance_app:replace-with-a-local-finance-password@127.0.0.1:54329/sqlguard_local
SQLGUARD_DB_DSN_OPERATIONS=postgresql://sqlguard_ops_app:replace-with-a-local-operations-password@127.0.0.1:54329/sqlguard_local

# Admin-only DSN used by disposable PostgreSQL security tests.
SQLGUARD_TEST_PG_ADMIN_DSN=postgresql://sqlguard_admin:replace-with-a-local-admin-password@127.0.0.1:54329/sqlguard_local
